# AccessForge: copy this file to .env in the project root and edit the values.
# Docker Compose reads .env automatically. Recreate the app after changes:
# docker compose up -d --build proxclient
# For python main.py, export settings into the process environment yourself.

# Proxmox connection defaults. Publish checkout accounts from this cluster only.
PROXMOX_HOST=pve.example.edu
PROXMOX_PORT=8006
PROXMOX_REALM=pam
# Requires a trusted certificate on the Proxmox API.
VERIFY_SSL=true

# Replace with a long random secret before use. Generate one with:
# python3 -c 'import secrets; print(secrets.token_hex(32))'
# Keep it stable: checkout credentials are encrypted using this key.
FLASK_SECRET_KEY=replace-with-a-long-random-secret

# The supplied Nginx ingress terminates HTTPS. For direct HTTP development, use http.
PUBLIC_SCHEME=https

# Optional account checkout feature: true enables /checkout and /admin/checkouts.
# Configure project secrets and policy in AccessForge or SCE-web Checkout settings.
# Enable ACCESSFORGE_PLUGIN_ENABLE=1 separately in SCE-web to publish accounts.
ENABLE_ACCOUNT_CHECKOUT=false

# Checkout restrictions apply within AccessForge; no Proxmox management token is needed.
# Keep Proxmox logins enabled and restrict direct access using your firewall.
# CHECKOUT_PROXMOX_API_TOKEN from older deployments is no longer used.

# Trust X-Real-IP only from these proxy peers. Match your actual private ingress.
# Defaults below match the supplied Compose/Nginx deployment.
CHECKOUT_TRUSTED_PROXIES=127.0.0.1/32,::1/128,172.16.0.0/12

# Email verification delivery. SMTP is unnecessary if verification is off for a pool.
# Example: CHECKOUT_SMTP_HOST=smtp.example.edu
# Example: CHECKOUT_SMTP_FROM=accounts@example.com
CHECKOUT_SMTP_HOST=
CHECKOUT_SMTP_FROM=
CHECKOUT_SMTP_PORT=587
CHECKOUT_SMTP_USER=
CHECKOUT_SMTP_PASSWORD=
# 0: STARTTLS on port 587; 1: implicit TLS (also change the port to 465).
CHECKOUT_SMTP_SSL=0

# Optional browser/VM file transfers. Enable each direction independently.
ENABLE_VM_FILE_UPLOAD=false
ENABLE_VM_FILE_DOWNLOAD=false
# Legacy fallback, used only when a direction above has no explicit setting.
# ENABLE_VM_FILE_TRANSFER=false

# SPICE proxy destination. Empty host follows the signed-in user's Proxmox host.
SPICE_PROXY_HOST=
SPICE_PROXY_PORT=3128

# Appearance and logging.
DEFAULT_THEME=pokemon
LOG_LEVEL=INFO
DEBUG_HTTP=false

# Docker's host-gateway mapping used by the supplied Nginx container.
DOCKER_HOST_GATEWAY=host-gateway

# Direct Python / custom deployment settings. The supplied Compose file fixes
# these values; changing them requires a Compose override and matching proxy ports.
# PORT=8080
# SPICE_BRIDGE_HOST=127.0.0.1
# SPICE_BRIDGE_PORT=8081
# CHECKOUT_DATA_DIR=./data
# Compose mounts ./data at /app/data and initializes it for app UID/GID 1000.
# Back up that directory with the secret key.

# Direct Python / custom deployment embedding settings. To use these in Docker,
# explicitly pass them into the proxclient service through a Compose override.
# EMBED_ALLOW=true
# EMBED_ALLOW_ORIGINS=*
# EMBED_COOKIES=true
# HTTPS_CERT_FILE and HTTPS_KEY_FILE do not enable TLS; use the reverse proxy.
